# Copy to .env.local and fill in. On Vercel, set these in Project Settings.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Brand served on hosts that match no brand (localhost, Vercel previews).
DEFAULT_BRAND=dachshund

# One block per brand, named after the brand slug in src/lib/brands.ts.
# Credentials come from the brand's app in the Shopify Dev Dashboard.
SHOPIFY_DACHSHUND_STORE_DOMAIN=
SHOPIFY_DACHSHUND_CLIENT_SECRET=

SHOPIFY_929PRINTS_STORE_DOMAIN=
SHOPIFY_929PRINTS_CLIENT_SECRET=
